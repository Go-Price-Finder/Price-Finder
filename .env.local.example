# Copy this file to .env.local and fill in the values from your Supabase
# project's Settings → API page. .env.local is already git-ignored.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Used to build the email confirmation link Supabase sends on sign-up
# (lib/supabase/actions.ts). Set this to your deployed URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# From address for all transactional email (lib/email/resend.ts). MUST be
# on the Resend-verified send.gopricefinder.com subdomain — the bare domain
# is not verified, and leaving this unset falls back to onboarding@resend.dev,
# which delivers only to the Resend account owner and silently reaches
# nobody else (findings doc §9b). Set in Vercel too.
RESEND_FROM_EMAIL="Go Price Finder <alerts@send.gopricefinder.com>"

# healthchecks.io ping key for the cron dead-man's switch
# (lib/monitoring/pingHealthcheck.ts). Optional: unset = pings off and the
# crons run exactly as before, but the missed-ping alerting is INERT.
HEALTHCHECKS_PING_KEY=your-healthchecks-ping-key
