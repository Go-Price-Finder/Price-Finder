# Normalize line endings for text files to this repo's existing convention
# (LF) instead of relying on each contributor's core.autocrlf setting,
# which is what was causing "LF will be replaced by CRLF" warnings.
* text=auto eol=lf

# Binary assets — never subject to line-ending conversion.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.zip binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.pdf binary
